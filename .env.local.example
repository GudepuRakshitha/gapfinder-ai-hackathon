# ─────────────────────────────────────────────────────────────────────────────
# GapFinder AI — environment variables
# Copy this file to `.env.local` and fill in the values you have.
# Every value is optional for local development: without them GapFinder runs in
# local JSON mode and uses its rule-based AI fallbacks.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI (Groq / Llama) ────────────────────────────────────────────────────────
# Create a key at https://console.groq.com/keys
# Without it: quizzes use the grounded extractive generator, the tutor returns
# retrieved source excerpts, and gap/plan narratives are rule-based.
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile with an automatic fallback to
# llama-3.1-8b-instant if the configured model is unavailable.
GROQ_MODEL=llama-3.3-70b-versatile

# ── Supabase (cloud persistence + auth) ──────────────────────────────────────
# Cloud mode activates only when ALL THREE values below are present.
# Otherwise the app persists to `.data/store.json` (local mode).
# Run `supabase/schema.sql` in the Supabase SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Sessions ─────────────────────────────────────────────────────────────────
# Secret used to sign local-mode session cookies (scrypt password hashing).
# Required in production when running without Supabase, because Vercel's
# filesystem is ephemeral. Generate with: openssl rand -hex 32
AUTH_SECRET=

# ── Storage (local mode only) ────────────────────────────────────────────────
# Optional path to the JSON data file. Defaults to `.data/store.json` in the
# project root, or a temp directory on read-only platforms such as Vercel.
# GAPFINDER_DATA_FILE=
